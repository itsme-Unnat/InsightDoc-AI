# InsightDoc AI - Backend Environment Variables

PORT=5000
NODE_ENV=development

# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas URI (Leave empty to use built-in high-performance In-Memory Vector Store for zero-setup demo)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/insightdoc?retryWrites=true&w=majority
MONGO_URI=

# Vector Search Index Configuration
# Set the name of the Atlas Vector Search index configured in Atlas
VECTOR_INDEX_NAME=vector_index

# Model Configurations
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash
